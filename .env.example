# =============================================================
# ไฟล์นี้เก็บค่า config ทั้งหมดของฝั่ง server (collector, mongodb, backend)
# docker compose จะอ่านไฟล์นี้อัตโนมัติแล้วส่งค่าแต่ละตัวเข้าไปเป็น
# environment variable ของแต่ละ service ตามที่ระบุไว้ใน docker-compose.yml
# =============================================================

# ที่อยู่ของ MQTT broker
MQTT_BROKER=mqtt
MQTT_PORT=1883

# topic ที่ collector จะ subscribe
MQTT_TOPIC=smartbin/+/data

# prefix ของ topic ที่ backend จะ publish ค่า threshold หรือ command กลับไปหาบอร์ด
MQTT_CONFIG_TOPIC_PREFIX=smartbin

# connection string ของ MongoDB
MONGO_URL=mongodb://mongodb:27017

# ชื่อ database ที่จะเก็บข้อมูล sensor ของถังขยะ
MONGO_DB_NAME=smartbin_db

# ชื่อ collection ที่จะเก็บข้อมูล sensor แต่ละรายการที่อ่านได้
MONGO_COLLECTION_NAME=smartbin_readings

# ชื่อ collection ที่จะเก็บค่า threshold ล่าสุดที่ตั้งไว้ของแต่ละถัง
MONGO_THRESHOLD_COLLECTION_NAME=smartbin_thresholds

# รายชื่อถังที่ระบบรู้จักล่วงหน้า (คั่นด้วย comma ไม่มีเว้นวรรค)
KNOWN_BINS=smartbin01

# ถ้าถังไหนไม่ส่งข้อมูลเข้ามาเกินกี่วินาที ให้ dashboard ถือว่า OFFLINE
BIN_OFFLINE_THRESHOLD_SECONDS=30

# ค่า threshold เริ่มต้น
MQ_DANGER_DEFAULT=600
FULL_DISTANCE_DEFAULT=4.0
